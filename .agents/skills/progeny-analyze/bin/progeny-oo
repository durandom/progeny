#!/usr/bin/env bash
# progeny-oo — query progenyd telemetry stored in OpenObserve.
#
# Usage:
#   progeny-oo logs    "SELECT ... FROM \"<logs_stream>\" WHERE service_name='progenyd' ..." [--hours N]
#   progeny-oo metrics "SELECT value,state FROM \"progeny_host_cpu_percent\" ..."            [--hours N]
#   progeny-oo streams                 # list metric/log stream names
#   progeny-oo env                     # show resolved URL + org (creds masked)
#
# Credentials resolve in three steps, first hit wins:
#   1. OPENOBSERVE_URL / _USER / _PASSWORD already in the environment
#   2. an env file, if one exists (PROGENY_OO_ENV, else ~/.config/progeny/openobserve.env)
#   3. the estate source of truth, fetched over SSH from PROGENY_OO_SSH_HOST
#      (default mimas.tailc66a3b.ts.net) out of ~/.config/otel/env
#
# Step 3 exists because step 2 is fragile: ~/.config/progeny/openobserve.env was a
# symlink into ~/.config/spellkave/telemetry/, and when that project retired its
# telemetry the symlink dangled and every query here died with a message that named
# the wrong problem. Fetching on demand keeps exactly one copy of the credential,
# which is the same argument orrery's scripts/openobserve-dashboard.py makes.
#
# Time range defaults to the last 1h; override with --hours N.
# Emits raw JSON — pipe to `python3 -m json.tool` or `jq`.
set -euo pipefail

OO_SSH_HOST="${PROGENY_OO_SSH_HOST:-mimas.tailc66a3b.ts.net}"
OO_URL_DEFAULT="${PROGENY_OO_URL:-http://otel.tailc66a3b.ts.net:5080}"

# 1. environment
if [ -z "${OPENOBSERVE_USER:-}" ] || [ -z "${OPENOBSERVE_PASSWORD:-}" ]; then
  # 2. env file, only if it actually resolves (-f follows symlinks, so a dangling
  #    link correctly falls through to step 3 instead of aborting)
  ENV_FILE="${PROGENY_OO_ENV:-$HOME/.config/progeny/openobserve.env}"
  if [ -f "$ENV_FILE" ]; then
    set -a; . "$ENV_FILE"; set +a
  fi
fi

if [ -z "${OPENOBSERVE_USER:-}" ] || [ -z "${OPENOBSERVE_PASSWORD:-}" ]; then
  # 3. estate source of truth over SSH. BatchMode so a missing key fails fast
  #    instead of hanging on a password prompt.
  if ! creds=$(ssh -o BatchMode=yes -o ConnectTimeout=8 "$OO_SSH_HOST" \
        '. ~/.config/otel/env; printf "%s\n%s\n" "$ZO_ROOT_USER_EMAIL" "$ZO_ROOT_USER_PASSWORD"' 2>/dev/null); then
    echo "progeny-oo: no credentials." >&2
    echo "  tried: environment, ${ENV_FILE:-<none>}, then ssh $OO_SSH_HOST:~/.config/otel/env" >&2
    echo "  the ssh fetch failed - check tailnet reachability and key-based auth to $OO_SSH_HOST." >&2
    exit 1
  fi
  OPENOBSERVE_USER=$(printf '%s\n' "$creds" | sed -n 1p)
  OPENOBSERVE_PASSWORD=$(printf '%s\n' "$creds" | sed -n 2p)
  if [ -z "$OPENOBSERVE_USER" ] || [ -z "$OPENOBSERVE_PASSWORD" ]; then
    echo "progeny-oo: $OO_SSH_HOST:~/.config/otel/env did not yield both ZO_ROOT_USER_*" >&2
    exit 1
  fi
fi

OPENOBSERVE_URL="${OPENOBSERVE_URL:-$OO_URL_DEFAULT}"
ORG="${OPENOBSERVE_ORG:-default}"
AUTH="$OPENOBSERVE_USER:$OPENOBSERVE_PASSWORD"

case "${1:-}" in
  env)     echo "url=$OPENOBSERVE_URL org=$ORG user=$OPENOBSERVE_USER pw=****"; exit 0 ;;
  streams)
    for t in metrics logs; do
      echo "=== $t ==="
      curl -sS -u "$AUTH" "$OPENOBSERVE_URL/api/$ORG/streams?type=$t" \
        | python3 -c "import json,sys;[print(' -',s['name']) for s in json.load(sys.stdin).get('list',[])]"
    done; exit 0 ;;
  logs|metrics|traces) TYPE="$1"; shift ;;
  *) echo "usage: progeny-oo <logs|metrics|traces|streams|env> \"<SQL>\" [--hours N]" >&2; exit 2 ;;
esac

SQL="${1:?SQL required}"; shift || true
HOURS=1
while [ $# -gt 0 ]; do case "$1" in --hours) HOURS="$2"; shift 2 ;; *) echo "unknown flag $1" >&2; exit 1 ;; esac; done

read -r START END < <(python3 -c "import time;n=time.time();print(int((n-$HOURS*3600)*1_000_000),int(n*1_000_000))")
BODY=$(python3 -c 'import json,sys;print(json.dumps({"query":{"sql":sys.argv[1],"start_time":int(sys.argv[2]),"end_time":int(sys.argv[3])}}))' "$SQL" "$START" "$END")

curl -sS -u "$AUTH" "$OPENOBSERVE_URL/api/$ORG/_search?type=$TYPE" \
  -H 'content-type: application/json' -d "$BODY"
