#!/usr/bin/env bash
# pg-oo — query progenyd telemetry stored in OpenObserve.
#
# Usage:
#   pg-oo logs    "SELECT ... FROM \"<logs_stream>\" WHERE service_name='progenyd' ..." [--hours N]
#   pg-oo metrics "SELECT value,state FROM \"progeny_host_cpu_percent\" ..."            [--hours N]
#   pg-oo streams                 # list metric/log stream names
#   pg-oo env                     # show resolved URL + org (creds masked)
#
# Reads OpenObserve connection from an env file (default ~/.config/progeny/openobserve.env,
# override with PROGENY_OO_ENV) that exports OPENOBSERVE_URL, OPENOBSERVE_USER,
# OPENOBSERVE_PASSWORD, and optionally OPENOBSERVE_ORG. Time range defaults to the
# last 1h; override with --hours N. Emits raw JSON — pipe to `python3 -m json.tool` or `jq`.
set -euo pipefail

ENV_FILE="${PROGENY_OO_ENV:-$HOME/.config/progeny/openobserve.env}"
[ -f "$ENV_FILE" ] || { echo "no OpenObserve env at $ENV_FILE (set PROGENY_OO_ENV)" >&2; exit 1; }
set -a; . "$ENV_FILE"; set +a
: "${OPENOBSERVE_URL:?OPENOBSERVE_URL missing in $ENV_FILE}"
: "${OPENOBSERVE_USER:?OPENOBSERVE_USER missing}"
: "${OPENOBSERVE_PASSWORD:?OPENOBSERVE_PASSWORD missing}"
ORG="${OPENOBSERVE_ORG:-default}"
AUTH="$OPENOBSERVE_USER:$OPENOBSERVE_PASSWORD"

case "${1:-}" in
  env)     echo "url=$OPENOBSERVE_URL org=$ORG user=$OPENOBSERVE_USER pw=****"; exit 0 ;;
  streams)
    for t in metrics logs; do
      echo "=== $t ==="
      curl -sS -u "$AUTH" "$OPENOBSERVE_URL/api/$ORG/streams?type=$t" \
        | python3 -c "import json,sys;[print(' -',s['name']) for s in json.load(sys.stdin).get('list',[])]"
    done; exit 0 ;;
  logs|metrics|traces) TYPE="$1"; shift ;;
  *) echo "usage: pg-oo <logs|metrics|traces|streams|env> \"<SQL>\" [--hours N]" >&2; exit 2 ;;
esac

SQL="${1:?SQL required}"; shift || true
HOURS=1
while [ $# -gt 0 ]; do case "$1" in --hours) HOURS="$2"; shift 2 ;; *) echo "unknown flag $1" >&2; exit 1 ;; esac; done

read -r START END < <(python3 -c "import time;n=time.time();print(int((n-$HOURS*3600)*1_000_000),int(n*1_000_000))")
BODY=$(python3 -c 'import json,sys;print(json.dumps({"query":{"sql":sys.argv[1],"start_time":int(sys.argv[2]),"end_time":int(sys.argv[3])}}))' "$SQL" "$START" "$END")

curl -sS -u "$AUTH" "$OPENOBSERVE_URL/api/$ORG/_search?type=$TYPE" \
  -H 'content-type: application/json' -d "$BODY"
