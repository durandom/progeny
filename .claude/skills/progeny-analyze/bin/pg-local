#!/usr/bin/env bash
# pg-local — query the progenyd IN-RAM forensic buffer (localhost, no SSD, full
# per-PID fidelity over the recent window ~4h). Complements pg-oo (OpenObserve),
# which holds summarized long-term data.
#
# Usage:
#   pg-local stats                 # buffer fill + time window
#   pg-local latest                # every process in the newest snapshot (NDJSON)
#   pg-local pid  <pid>            # one PID's trajectory across every buffered tick
#   pg-local comm <name>          # all rows for a command over time (SWARM CHURN)
#   pg-local window <minutes>     # every process row in the last N minutes
#
# Output is NDJSON — pipe to jq / python3. Only reachable on this machine.
set -euo pipefail
PORT="${PROGENY_QUERY_PORT:-9847}"
route="${1:?usage: pg-local <stats|latest|pid|comm|window> [arg]}"
arg="${2:-}"
if [ -n "$arg" ]; then
  enc=$(python3 -c 'import urllib.parse,sys; print(urllib.parse.quote(sys.argv[1], safe=""))' "$arg")
  path="$route/$enc"
else
  path="$route"
fi
curl -sS -m 10 "http://127.0.0.1:$PORT/$path" \
  || { echo "progenyd query server not reachable on :$PORT (is the daemon running with PROGENY_QUERY=1?)" >&2; exit 1; }
